@page "/yazarlar"
@using KursuTV.Business.DTOs
@using KursuTV.SharedUI.Components
@inject UserApiService UserApi
@inject NewsApiService NewsApi

<PageTitle>Köşe Yazarları - Kürsü TV</PageTitle>

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col justify-between">
    <div>
        <Header />

        <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
            <div class="border-b-2 border-red-600 pb-3">
                <h1 class="text-2xl font-black text-slate-900 uppercase tracking-tight">KÜRSÜ TV YAZAR KADROSU</h1>
                <p class="text-xs text-slate-500 mt-1">Türkiye ve dünya gündemini yorumlayan usta kalemlerimiz.</p>
            </div>

            @if (authors.Count > 0)
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                    @for (int i = 0; i < authors.Count; i++)
                    {
                        var author = authors[i];
                        <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="w-16 h-16 rounded-full border-2 border-red-500 shadow-sm shrink-0 overflow-hidden bg-slate-900 flex items-center justify-center">
                                    @if (!string.IsNullOrEmpty(author.Photo) && !author.Photo.Contains("default-avatar"))
                                    {
                                        <img src="@author.Photo" alt="@author.Name" class="w-full h-full object-cover" />
                                    }
                                    else
                                    {
                                        <span class="text-xl font-black text-white">@author.Name.FirstOrDefault()</span>
                                    }
                                </div>
                                <div>
                                    <h3 class="text-base font-bold text-slate-900 leading-tight">@author.Name</h3>
                                    <span class="text-xs text-red-600 font-semibold">@author.Title</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(author.ArticleSlug))
                            {
                                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
                                    <span class="text-[10px] uppercase font-bold text-slate-400">Son Köşe Yazısı:</span>
                                    <a href="/haber/@author.ArticleSlug" class="block text-xs font-bold text-slate-800 hover:text-red-600 transition-colors line-clamp-2">
                                        @author.LastArticle
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                                    <span class="text-xs text-slate-400 italic">@author.LastArticle</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (!isLoading)
            {
                <div class="py-16 text-center text-slate-400 text-xs">
                    Henüz kayıtlı köşe yazarı bulunmuyor.
                </div>
            }
        </main>
    </div>

    <Footer />
</div>

@code {
    public record AuthorCard(string Name, string Title, string Photo, string LastArticle, string ArticleSlug);

    private List<AuthorCard> authors = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var userAuthors = await UserApi.GetAuthorsAsync();
            var columnArticles = await NewsApi.GetColumnNewsAsync(20);

            authors = userAuthors.Select(u =>
            {
                var latestArticle = columnArticles.FirstOrDefault(a => a.AuthorName == u.FullName);
                return new AuthorCard(
                    Name: u.FullName,
                    Title: !string.IsNullOrWhiteSpace(u.Bio) ? u.Bio : "Kürsü TV Köşe Yazarı",
                    Photo: u.ProfileImageUrl ?? "",
                    LastArticle: latestArticle?.Title ?? "Yakında yeni yazısıyla burada olacak",
                    ArticleSlug: latestArticle?.Slug ?? ""
                );
            }).ToList();
        }
        catch
        {
            authors = new();
        }
        finally
        {
            isLoading = false;
        }
    }
}
