@code {
    private List<MessageDto> messages = new();
    private int tokenBalance = 0;
    private bool isLoading = true;
    private Guid? replyingToMessageId = null;
    private string replyText = string.Empty;
    private bool isSendingReply = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadMessages();
            await LoadTokenBalance();
            StateHasChanged();
        }
    }

    private async Task LoadMessages()
    {
        try
        {
            messages = await MessageService.GetInboxAsync(Guid.Empty);
        }
        catch (Exception)
        {
            // Prerendering sÄ±rasÄ±nda JS Ã§aÄŸÄ±rÄ±lamaz
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTokenBalance()
    {
        try
        {
            tokenBalance = await TokenService.GetBalanceAsync(Guid.Empty);
        }
        catch (Exception)
        {
            tokenBalance = 0;
        }
    }

    private async Task UnlockMessage(Guid messageId)
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] Mesaj kilidi aÃ§Ä±lÄ±yor: {messageId}");
            await MessageService.UnlockMessageAsync(messageId, Guid.Empty);
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] BAÅARILI: Mesaj kilidi aÃ§Ä±ldÄ±.");
            
            var msg = messages.FirstOrDefault(m => m.Id == messageId);
            if (msg != null)
            {
                msg.IsUnlocked = true;
                tokenBalance--;
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] HATA: Mesaj kilidi aÃ§Ä±lamadÄ±.", ex.Message);
        }
    }

    private void ShowReplyForm(Guid messageId)
    {
        replyingToMessageId = messageId;
        replyText = string.Empty;
    }

    private void CancelReply()
    {
        replyingToMessageId = null;
        replyText = string.Empty;
    }

    private async Task SendReply()
    {
        if (string.IsNullOrWhiteSpace(replyText) || replyingToMessageId == null)
            return;

        isSendingReply = true;

        try
        {
            await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] Mesaja yanÄ±t gÃ¶nderiliyor... Mesaj ID: {replyingToMessageId}");
            
            // GerÃ§ek API'de alÄ±cÄ± ID'sini orijinal mesajdan Ã§ekmeliyiz
            var originalMsg = messages.FirstOrDefault(m => m.Id == replyingToMessageId);
            if (originalMsg == null) return;

            var dto = new MessageSendDto { 
                ReceiverId = originalMsg.SenderId, 
                ListingId = originalMsg.ListingId, 
                Content = replyText 
            };
            
            await MessageService.SendMessageAsync(dto, Guid.Empty);
            
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] BAÅARILI: YanÄ±t gÃ¶nderildi.");

            replyingToMessageId = null;
            replyText = string.Empty;
            await LoadMessages(); // Listeyi yenile
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] HATA: YanÄ±t gÃ¶nderilemedi.", ex.Message);
        }
        finally
        {
            isSendingReply = false;
        }
    }
}
