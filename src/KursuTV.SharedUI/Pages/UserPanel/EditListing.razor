@code {
    [Parameter]
    public Guid ListingId { get; set; }

    private ListingUpdateDto? model;
    private List<BranchDto> branches = new();
    private List<CityDto> cities = new();
    private List<DistrictDto> districts = new();
    private int selectedCityId = 0;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadFormData();
            await LoadListing();
            StateHasChanged();
        }
    }

    private async Task LoadListing()
    {
        try
        {
            await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] Ä°lan detaylarÄ± Ã§ekiliyor: {ListingId}");
            var listing = await ListingService.GetByIdAsync(ListingId);
            
            if (listing != null)
            {
                model = new ListingUpdateDto
                {
                    Type = listing.Type,
                    Title = listing.Title,
                    Description = listing.Description,
                    BranchId = branches.FirstOrDefault(b => b.Name == listing.BranchName)?.Id ?? 0,
                    LessonType = listing.LessonType,
                    HourlyPrice = listing.HourlyPrice,
                    DistrictId = 0, // Bu kÄ±smÄ± API'den doÄŸru Ã§ekmek gerekebilir
                    IsActive = listing.Status == ListingStatus.Active
                };
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "[KursuTV Tracker] HATA: Ä°lan yÃ¼klenenemedi.", ex.Message);
            model = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadFormData()
    {
        try
        {
            var branchResult = await Http.GetFromJsonAsync<List<BranchDto>>("api/branches");
            if (branchResult != null) branches = branchResult;

            var cityResult = await Http.GetFromJsonAsync<List<CityDto>>("api/cities");
            if (cityResult != null) cities = cityResult;
            
            await LoadDistricts();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "[KursuTV Tracker] HATA: Form verileri (branÅŸ/ÅŸehir) yÃ¼klenemedi.", ex.Message);
        }
    }

    private async Task LoadDistricts()
    {
        districts.Clear();

        if (selectedCityId > 0)
        {
             try
            {
                var city = cities.FirstOrDefault(c => c.Id == selectedCityId);
                if (city != null && city.Districts != null)
                {
                    districts = city.Districts;
                }
            }
            catch
            {
                // API henÃ¼z Ã§alÄ±ÅŸmÄ±yorsa
            }
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            if (string.IsNullOrWhiteSpace(model?.Title))
            {
                errorMessage = "Ä°lan baÅŸlÄ±ÄŸÄ± zorunludur.";
                return;
            }

            if (model.BranchId == 0)
            {
                errorMessage = "LÃ¼tfen bir branÅŸ seÃ§in.";
                return;
            }

            await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] Ä°lan gÃ¼ncelleniyor: {ListingId}");
            
            await ListingService.UpdateAsync(ListingId, model, Guid.Empty);
            
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] BAÅARILI: Ä°lan gÃ¼ncellendi.");
            Navigation.NavigateTo("/panel/ilanlarim");
        }
        catch (Exception ex)
        {
            errorMessage = "Ä°lan gÃ¼ncellenirken bir hata oluÅŸtu: " + ex.Message;
            await JS.InvokeVoidAsync("console.error", "[KursuTV Tracker] HATA: Ä°lan gÃ¼ncellenemedi.", ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/panel/ilanlarim");
    }
}
