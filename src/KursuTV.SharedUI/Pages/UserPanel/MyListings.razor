                            <option value="newest">En Yeni</option>
                            <option value="oldest">En Eski</option>
                            <option value="price-high">Fiyat (YÃ¼ksek)</option>
                            <option value="price-low">Fiyat (DÃ¼ÅŸÃ¼k)</option>
                        </select>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="grid grid-3">
                        @for (int i = 0; i < 3; i++)
