<AuthorizeView>
    <Authorized>
        <section class="section my-listings-page">
            <div class="container">
                <PageHeader Title="Ä°lanlarÄ±m" Subtitle="TÃ¼m ilanlarÄ±nÄ±zÄ± buradan yÃ¶netebilirsiniz" BackUrl="/panel/dashboard">
                    <Actions>
