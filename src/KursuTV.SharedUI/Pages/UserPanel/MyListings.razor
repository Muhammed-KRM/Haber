@code {
    private List<ListingDto>? listings;
    private List<ListingDto>? filteredListings;
    private bool isLoading = true;
    private string statusFilter = "all";
    private string sortBy = "newest";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadListings();
            StateHasChanged();
        }
    }

    private async Task LoadListings()
    {
        isLoading = true;
        try
        {
            listings = await ListingService.GetMyListingsAsync(Guid.Empty);
            FilterListings();
        }
        catch (HttpRequestException ex)
        {
            await JS.InvokeVoidAsync("console.error", "[KursuTV] Ä°lanlar yÃ¼klenemedi:", ex.Message);
            try
            {
                await JS.InvokeVoidAsync("kursutv.showSwal", "error", "Veri YÃ¼kleme HatasÄ±", "API baÄŸlantÄ±sÄ± kurulamadÄ±. SayfayÄ± yenilemeyi deneyin.", 0);
            }
            catch { /* Prerendering sÄ±rasÄ±nda JS Ã§aÄŸÄ±rÄ±lamaz */ }
        }
        catch (Exception ex)
        {
            // Prerendering sÄ±rasÄ±nda JS Ã§aÄŸÄ±rÄ±lamaz, sessizce geÃ§
            try
            {
                await JS.InvokeVoidAsync("console.error", "[KursuTV] Ä°lanlar yÃ¼klenirken hata:", ex.Message);
            }
            catch { }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterListings()
    {
        if (listings == null)
        {
            filteredListings = null;
            return;
        }

        var filtered = listings.AsEnumerable();

        // Durum filtresi
        if (statusFilter != "all")
        {
            filtered = filtered.Where(l => l.Status.ToString().ToLower() == statusFilter);
        }

        // SÄ±ralama
        filtered = sortBy switch
        {
            "newest" => filtered.OrderByDescending(l => l.CreatedAt),
            "oldest" => filtered.OrderBy(l => l.CreatedAt),
            "price-high" => filtered.OrderByDescending(l => l.HourlyPrice),
            "price-low" => filtered.OrderBy(l => l.HourlyPrice),
            _ => filtered
        };

        filteredListings = filtered.ToList();
    }

    private string GetStatusText(ListingStatus status)
    {
        return status switch
        {
            ListingStatus.Active => "YayÄ±nda",
            ListingStatus.Pending => "Onay Bekliyor",
            ListingStatus.Suspended => "AskÄ±ya AlÄ±ndÄ±",
            ListingStatus.Closed => "KapatÄ±ldÄ±",
            _ => "Bilinmiyor"
        };
    }

    private string GetLessonTypeText(LessonType type)
    {
        return type switch
        {
            LessonType.FaceToFace => "YÃ¼z YÃ¼ze",
            LessonType.Online => "Online",
            LessonType.Both => "Hibrit",
            _ => "BelirtilmemiÅŸ"
        };
    }

    private async Task PromoteListing(Guid listingId)
    {
        // Vitrin satÄ±n alma sayfasÄ±na yÃ¶nlendir
        Navigation.NavigateTo($"/panel/vitrin-satin-al/{listingId}");
    }

    private async Task DeleteListing(Guid listingId)
    {
        var confirmed = await JS.InvokeAsync<bool>("kursutv.showConfirm", "Ä°lanÄ± Sil", "Bu ilanÄ± silmek istediÄŸinize emin misiniz? Bu iÅŸlem geri alÄ±namaz.", "Evet, Sil", "Ä°ptal");
        if (confirmed)
        {
            try
            {
                await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] Ä°lan siliniyor: {listingId}");
                await ListingService.DeleteAsync(listingId, Guid.Empty);
                await JS.InvokeVoidAsync("kursutv.showSwal", "success", "Silindi!", "Ä°lan baÅŸarÄ±yla silindi.", 2000);
                await LoadListings();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("kursutv.showSwal", "error", "Silinemedi", ex.Message, 0);
                await JS.InvokeVoidAsync("console.error", "[KursuTV Tracker] HATA: Ä°lan silinemedi.", ex.Message);
            }
        }
    }
}
