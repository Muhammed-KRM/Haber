@code {
    private int tokenBalance = 0;
    private int activeListingsCount = 0;
    private int unreadMessagesCount = 0;
    private double averageRating = 0;
    private int totalReviews = 0;
    private bool isLoading = true;

    private List<ListingDto>? recentListings;
    private List<UserActivityDto>? recentActivities;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("console.log", "[Dashboard] OnAfterRenderAsync(firstRender) â€” veri yÃ¼kleniyor...");
        await LoadDashboardData();
        StateHasChanged();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("console.log", "[Dashboard] TokenService.GetBalanceAsync Ã§aÄŸrÄ±lÄ±yor...");
            tokenBalance = await TokenService.GetBalanceAsync(Guid.Empty);
            await JS.InvokeVoidAsync("console.log", $"[Dashboard] Bakiye: {tokenBalance}");

            await JS.InvokeVoidAsync("console.log", "[Dashboard] ListingService.GetMyListingsAsync Ã§aÄŸrÄ±lÄ±yor...");
            var mylistings = await ListingService.GetMyListingsAsync(Guid.Empty);
            recentListings = mylistings?.Take(3).ToList() ?? new List<ListingDto>();
            activeListingsCount = mylistings?.Count(l => l.Status.ToString().ToLower() == "active") ?? 0;
            await JS.InvokeVoidAsync("console.log", $"[Dashboard] Ä°lanlar: toplam={mylistings?.Count}, aktif={activeListingsCount}");

            await JS.InvokeVoidAsync("console.log", "[Dashboard] MessageService.GetInboxAsync Ã§aÄŸrÄ±lÄ±yor...");
            var inbox = await MessageService.GetInboxAsync(Guid.Empty);
            unreadMessagesCount = inbox?.Count(m => !m.IsUnlocked) ?? 0;
            await JS.InvokeVoidAsync("console.log", $"[Dashboard] Mesajlar: toplam={inbox?.Count}, okunmamÄ±ÅŸ={unreadMessagesCount}");

            averageRating = mylistings?.Select(l => l.AverageRating).DefaultIfEmpty(0).Average() ?? 0;
            totalReviews = mylistings?.Sum(l => l.ReviewCount) ?? 0;

            // GerÃ§ek aktiviteleri API'den Ã§ek
            try
            {
                var activitiesResult = await Http.GetFromJsonAsync<List<UserActivityDto>>("api/account/activities");
                recentActivities = activitiesResult ?? new List<UserActivityDto>();
                if (!recentActivities.Any())
                    recentActivities = new List<UserActivityDto>
                    {
                        new() { Icon = "ğŸ‰", Description = "KursuTV.com'a hoÅŸ geldiniz!", CreatedAt = DateTime.Now }
                    };
            }
            catch
            {
                recentActivities = new List<UserActivityDto>
                {
                    new() { Icon = "ğŸ‰", Description = "KursuTV.com'a hoÅŸ geldiniz!", CreatedAt = DateTime.Now }
                };
            }
            await JS.InvokeVoidAsync("console.log", "[Dashboard] TÃ¼m veriler baÅŸarÄ±yla yÃ¼klendi âœ“");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"[Dashboard] HATA: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
