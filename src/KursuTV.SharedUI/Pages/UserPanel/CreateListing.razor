@code {
    private ListingCreateDto model = new() 
    { 
        Type = ListingType.TeacherOffering,
        LessonType = LessonType.FaceToFace 
    };

    // SÄ±nÄ±f seÃ§enekleri: Value=sÄ±nÄ±f numarasÄ±, Label=gÃ¶rÃ¼nen ad
    private static readonly (int Value, string Label)[] GradeOptions =
    [
        (0,  "AnasÄ±nÄ±fÄ±"),
        (1,  "1. SÄ±nÄ±f"),  (2,  "2. SÄ±nÄ±f"),  (3,  "3. SÄ±nÄ±f"),  (4,  "4. SÄ±nÄ±f"),
        (5,  "5. SÄ±nÄ±f"),  (6,  "6. SÄ±nÄ±f"),  (7,  "7. SÄ±nÄ±f"),  (8,  "8. SÄ±nÄ±f"),
        (9,  "9. SÄ±nÄ±f"),  (10, "10. SÄ±nÄ±f"), (11, "11. SÄ±nÄ±f"), (12, "12. SÄ±nÄ±f"),
        (13, "Ãœniversite"), (14, "Mezun / YetiÅŸkin"),
    ];
    private List<BranchDto> branches = new();
    private List<CityDto> cities = new();
    private List<DistrictDto> districts = new();
    private int selectedCityId = 0;
    private bool isSubmitting = false;
    private string? errorMessage;

    // FotoÄŸraf yÃ¼kleme
    private List<string> uploadedImageUrls = new();
    private bool isUploadingImages = false;
    private string? uploadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadFormData();
            StateHasChanged();
        }
    }

    private async Task LoadFormData()
    {
        try
        {
            var branchResult = await Http.GetFromJsonAsync<List<BranchDto>>("api/branches");
            if (branchResult != null) branches = branchResult;

            var cityResult = await Http.GetFromJsonAsync<List<CityDto>>("api/cities");
            if (cityResult != null) cities = cityResult;
            
            await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] {branches.Count} branÅŸ ve {cities.Count} ÅŸehir API'den baÅŸarÄ±yla yÃ¼klendi.");
        }
        catch (Exception ex)
        {
            errorMessage = "BranÅŸ ve ÅŸehir bilgileri yÃ¼klenirken hata oluÅŸtu.";
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] HATA: Veriler API'den Ã§ekilemedi: ", ex.Message);
        }
    }

    private async Task LoadDistricts()
    {
        districts.Clear();
        model.DistrictId = 0;

        if (selectedCityId > 0)
        {
            try
            {
                var city = cities.FirstOrDefault(c => c.Id == selectedCityId);
                if (city != null && city.Districts != null)
                {
                    districts = city.Districts;
                }
                else
                {
                    // Fallback to fetch from an API if needed, but our Cities API seems to include Districts
                }
            }
            catch
            {
                // API henÃ¼z Ã§alÄ±ÅŸmÄ±yorsa
            }
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] Ä°lan yayÄ±nlama iÅŸlemi baÅŸlatÄ±ldÄ±...");

        try
        {
            // Validasyon
            if (string.IsNullOrWhiteSpace(model.Title))
            {
                await JS.InvokeVoidAsync("kursutv.showSwal", "warning", "Eksik Alan", "Ä°lan baÅŸlÄ±ÄŸÄ± zorunludur.", 0);
                return;
            }

            if (model.BranchId == 0)
            {
                await JS.InvokeVoidAsync("kursutv.showSwal", "warning", "Eksik Alan", "LÃ¼tfen bir branÅŸ seÃ§in.", 0);
                return;
            }

            if (model.DistrictId == 0)
            {
                await JS.InvokeVoidAsync("kursutv.showSwal", "warning", "Eksik Alan", "LÃ¼tfen ÅŸehir ve ilÃ§e seÃ§in.", 0);
                return;
            }

            // Payload loglama
            var payloadStr = System.Text.Json.JsonSerializer.Serialize(model, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] ----- API Ä°STEK DETAYI -----");
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] URL: /api/listings");
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] Authorization: Bearer token AuthTokenHandler tarafÄ±ndan otomatik ekleniyor");
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] Payload: \n" + payloadStr);
            await JS.InvokeVoidAsync("console.log", "[KursuTV Tracker] ------------------------------");

            // API'ye gÃ¶nder
            model.ImageUrls = uploadedImageUrls;
            var result = await ListingService.CreateAsync(model, Guid.Empty);
            // Moderasyon uyarÄ±sÄ± varsa SweetAlert2 ile bÃ¼yÃ¼k popup gÃ¶ster
            if (!string.IsNullOrEmpty(result.ModerationMessage))
            {
                await JS.InvokeVoidAsync("kursutv.showSwal", "warning",
                    "âš ï¸ Ä°lan Ä°ncelemeye AlÄ±ndÄ±",
                    $"Ä°lanÄ±nÄ±z platform kurallarÄ±na aykÄ±rÄ± iÃ§erik barÄ±ndÄ±rdÄ±ÄŸÄ± iÃ§in incelemeye alÄ±ndÄ±.\n\nSebep: {result.ModerationMessage}\n\nÄ°lanÄ±nÄ±z admin onayÄ±ndan sonra yayÄ±na girecektir.",
                    0);
                Navigation.NavigateTo("/panel/ilanlarim");
                return;
            }

            await JS.InvokeVoidAsync("kursutv.showSwal", "success", "Ä°lan YayÄ±nlandÄ±! ğŸ‰", "Ä°lanÄ±nÄ±z baÅŸarÄ±yla oluÅŸturuldu.", 2500);
            await Task.Delay(2600);
            Navigation.NavigateTo("/panel/ilanlarim");
        }
        catch (HttpRequestException ex)
        {
            var rawMsg = ex.Message;
            var friendlyMsg = rawMsg;
            try
            {
                if (rawMsg.Contains("{"))
                {
                    var jsonPart = rawMsg.Substring(rawMsg.IndexOf("{"));
                    var doc = System.Text.Json.JsonDocument.Parse(jsonPart);
                    if (doc.RootElement.TryGetProperty("detail", out var detail))
                        friendlyMsg = detail.GetString() ?? rawMsg;
                }
            }
            catch { /* JSON parse baÅŸarÄ±sÄ±zsa ham mesajÄ± kullan */ }
            errorMessage = friendlyMsg;
            await JS.InvokeVoidAsync("kursutv.showSwal", "error", "Ä°lan OluÅŸturulamadÄ±", friendlyMsg, 0);
            await JS.InvokeVoidAsync("console.error", "[KursuTV Tracker] HATA DETAYI:", ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            await JS.InvokeVoidAsync("kursutv.showSwal", "error", "Beklenmeyen Hata", ex.Message, 0);
            await JS.InvokeVoidAsync("console.error", "[KursuTV Tracker] HATA:", ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/panel/ilanlarim");
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        uploadError = null;
        if (uploadedImageUrls.Count >= 5)
        {
            uploadError = "En fazla 5 fotoÄŸraf yÃ¼kleyebilirsiniz.";
            return;
        }

        isUploadingImages = true;
        StateHasChanged();

        foreach (var file in e.GetMultipleFiles(5))
        {
            if (uploadedImageUrls.Count >= 5) break;

            if (file.Size > 5 * 1024 * 1024)
            {
                uploadError = $"{file.Name} dosyasÄ± 5MB'dan bÃ¼yÃ¼k.";
                continue;
            }

            try
            {
                using var content = new MultipartFormDataContent();
                using var stream = file.OpenReadStream(5 * 1024 * 1024);
                using var streamContent = new StreamContent(stream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "file", file.Name);

                var response = await Http.PostAsync("api/upload", content);
                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<UploadResultDto>();
                    if (result?.ImageUrl != null)
                        uploadedImageUrls.Add(result.ImageUrl);
                }
                else
                {
                    uploadError = $"{file.Name} yÃ¼klenemedi.";
                }
            }
            catch (Exception ex)
            {
                uploadError = $"YÃ¼kleme hatasÄ±: {ex.Message}";
            }
        }

        isUploadingImages = false;
    }

    private void RemoveImage(string url)
    {
        uploadedImageUrls.Remove(url);
    }

    private record UploadResultDto(string ImageUrl);
}