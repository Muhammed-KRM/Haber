@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    
    private ListingDto? listing;
    private bool isLoading = true;
    private string? experience;
    private List<string>? images;

    // Yorum sistemi
    private List<ReviewDto> reviews = new();
    private bool isLoadingReviews = true;
    private bool hasReviewed = false;
    private bool isSubmittingReview = false;
    private string? reviewError;
    private ReviewCreateDto newReview = new() { ProfessionalismRating = 5, CommunicationRating = 5, ValueRating = 5 };
    private Guid currentUserId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadListing();
        await LoadCurrentUser();
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var idClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (Guid.TryParse(idClaim, out var uid))
                    currentUserId = uid;
            }
        }
        catch { }
    }

    private async Task LoadListing()
    {
        isLoading = true;
        try
        {
            listing = await ListingService.GetBySlugAsync(Slug);
            if (listing != null)
            {
                experience = "5+ yÄ±l deneyim"; // API'den gelecek
                images = listing.ImageUrls?.ToList();
                newReview.ListingId = listing.Id;
                await LoadReviews();
            }
        }
        catch { }
        isLoading = false;
    }

    private async Task LoadReviews()
    {
        isLoadingReviews = true;
        try
        {
            if (listing != null)
            {
                reviews = await ReviewService.GetByListingAsync(listing.Id);
                hasReviewed = currentUserId != Guid.Empty && reviews.Any(r => r.ReviewerId == currentUserId);
            }
        }
        catch { }
        isLoadingReviews = false;
    }

    private async Task SubmitReview()
    {
        if (newReview.ProfessionalismRating == 0 || newReview.CommunicationRating == 0 || newReview.ValueRating == 0)
        {
            reviewError = "LÃ¼tfen tÃ¼m kategoriler iÃ§in puan verin.";
            return;
        }
        if (string.IsNullOrWhiteSpace(newReview.ReviewText) || newReview.ReviewText.Length < 10)
        {
            reviewError = "Yorum en az 10 karakter olmalÄ±dÄ±r.";
            return;
        }

        isSubmittingReview = true;
        reviewError = null;
        try
        {
            await ReviewService.CreateAsync(newReview, currentUserId);
            await LoadReviews();
            newReview = new ReviewCreateDto { ListingId = listing!.Id, ProfessionalismRating = 5, CommunicationRating = 5, ValueRating = 5, ReviewText = "" };
            await JS.InvokeVoidAsync("Swal.fire", "TeÅŸekkÃ¼rler!", "DeÄŸerlendirmeniz baÅŸarÄ±yla gÃ¶nderildi.", "success");
        }
        catch (Exception ex)
        {
            reviewError = ex.Message.Contains("kendi") ? "Kendi ilanÄ±nÄ±za yorum yapamazsÄ±nÄ±z." : "Yorum gÃ¶nderilemedi. LÃ¼tfen tekrar deneyin.";
        }
        isSubmittingReview = false;
    }

    private async Task SendMessage()
    {
        Navigation.NavigateTo($"/panel/mesajlarim?newMessage={listing?.OwnerId}");
    }

    private async Task SendOfferWithToken()
    {
        bool confirmed = false;
        try 
        {
            var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("Swal.fire", new
            {
                title = "Direkt Teklif GÃ¶nder",
                text = "Bu kiÅŸiye 1 Jeton harcayarak direkt teklif gÃ¶ndermek istiyor musunuz? MesajÄ±nÄ±z karÅŸÄ± tarafa direkt aÃ§Ä±k (okunabilir) olarak ulaÅŸÄ±r.",
                icon = "question",
                showCancelButton = true,
                confirmButtonColor = "#F59E0B",
                confirmButtonText = "Evet, 1 Jeton Harca",
                cancelButtonText = "Ä°ptal"
            });
            confirmed = result.GetProperty("isConfirmed").GetBoolean();
        }
        catch { confirmed = true; }

        if (confirmed && listing != null)
        {
            try
            {
                var dto = new KursuTV.Business.DTOs.MessageSendDto
                {
                    ReceiverId = listing.OwnerId,
                    ListingId = listing.Id,
                    Content = "Merhaba! Ä°lanÄ±nÄ±zÄ± inceledim ve size hizmetlerimle ilgili direkt teklif sunmak istiyorum. Ä°lgilenirseniz detaylarÄ± gÃ¶rÃ¼ÅŸebiliriz.",
                    IsDirectOffer = true
                };
                
                await MessageService.SendMessageAsync(dto, Guid.Empty);
                await JS.InvokeVoidAsync("Swal.fire", "BaÅŸarÄ±lÄ±", "Teklifiniz baÅŸarÄ±yla iletildi!", "success");
                Navigation.NavigateTo("/panel/mesajlarim");
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("Swal.fire", "Hata", ex.Message, "error");
            }
        }
    }
}
