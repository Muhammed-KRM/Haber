@page "/kunye"

<PageTitle>Künye | KursuTV.com</PageTitle>

<section class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Başlık Bandı -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-red-900 px-8 py-6">
            <h1 class="text-2xl font-black text-white tracking-tight">Künye</h1>
            <p class="text-xs text-slate-300 mt-1">KursuTV.com Yayın Bilgileri</p>
        </div>

        <div class="p-8 space-y-8">
            <!-- Yayın Bilgileri -->
            <div class="space-y-3">
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-200 pb-2">Yayın Kuruluşu</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Yayın Adı</span>
                        <p class="font-bold text-slate-900">Kürsü TV</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Yayın Türü</span>
                        <p class="font-bold text-slate-900">İnternet Haber Sitesi</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Yayın Dili</span>
                        <p class="font-bold text-slate-900">Türkçe</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Kuruluş Yılı</span>
                        <p class="font-bold text-slate-900">2024</p>
                    </div>
                </div>
            </div>

            <!-- Sorumlu Kişiler -->
            <div class="space-y-3">
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-200 pb-2">Sorumlu Yönetim</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Genel Yayın Yönetmeni</span>
                        <p class="font-bold text-slate-900">—</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Sorumlu Yazı İşleri Müdürü</span>
                        <p class="font-bold text-slate-900">—</p>
                    </div>
                    <div>
                        <span class="text-slate-500 text-xs font-medium">Editör</span>
                        <p class="font-bold text-slate-900">—</p>
                    </div>
                </div>
            </div>

            <!-- İletişim -->
            <div class="space-y-3">
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-200 pb-2">İletişim Bilgileri</h2>
                <div class="text-sm text-slate-700 space-y-1">
                    <p><span class="font-medium text-slate-500">E-Posta:</span> info@@kursutv.com</p>
                    <p><span class="font-medium text-slate-500">Web:</span> www.kursutv.com</p>
                </div>
            </div>

            <div class="text-[11px] text-slate-400 pt-4 border-t border-slate-100">
                Bu sayfadaki bilgiler 5187 sayılı Basın Kanunu gereği yayınlanmaktadır. Son güncelleme: @DateTime.Now.ToString("dd MMMM yyyy")
            </div>
        </div>
    </div>
</section>
