@page "/iletisim"

<PageTitle>İletişim | KursuTV.com</PageTitle>

<section class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Başlık Bandı -->
        <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-red-900 px-8 py-6">
            <h1 class="text-2xl font-black text-white tracking-tight">İletişim</h1>
            <p class="text-xs text-slate-300 mt-1">Bize ulaşın, görüş ve önerilerinizi paylaşın</p>
        </div>

        <div class="p-8 space-y-8">
            <!-- İletişim Bilgileri -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-slate-50 rounded-xl p-5 text-center space-y-2">
                    <div class="w-10 h-10 mx-auto bg-red-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900">E-Posta</h3>
                    <p class="text-xs text-slate-500">info@@kursutv.com</p>
                </div>

                <div class="bg-slate-50 rounded-xl p-5 text-center space-y-2">
                    <div class="w-10 h-10 mx-auto bg-red-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900">Adres</h3>
                    <p class="text-xs text-slate-500">Türkiye</p>
                </div>

                <div class="bg-slate-50 rounded-xl p-5 text-center space-y-2">
                    <div class="w-10 h-10 mx-auto bg-red-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/>
                        </svg>
                    </div>
                    <h3 class="text-sm font-bold text-slate-900">Web</h3>
                    <p class="text-xs text-slate-500">www.kursutv.com</p>
                </div>
            </div>

            <!-- Haber İhbar -->
            <div class="bg-red-50 border border-red-200 rounded-xl p-6 space-y-3">
                <h2 class="text-sm font-bold text-red-800">Haber İhbar Hattı</h2>
                <p class="text-xs text-red-700 leading-relaxed">
                    Haber ihbarlarınızı, fotoğraf ve videolarınızı <strong>ihbar@@kursutv.com</strong> adresine gönderebilirsiniz.
                    Gönderdiğiniz içerikler editörlerimiz tarafından incelenerek yayınlanacaktır.
                </p>
            </div>

            <!-- Sosyal Medya -->
            <div class="space-y-3">
                <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-200 pb-2">Sosyal Medya</h2>
                <div class="flex items-center gap-3">
                    <a href="#" class="w-10 h-10 bg-slate-900 hover:bg-red-600 transition-colors rounded-lg flex items-center justify-center text-white text-xs font-bold">X</a>
                    <a href="#" class="w-10 h-10 bg-slate-900 hover:bg-red-600 transition-colors rounded-lg flex items-center justify-center text-white text-xs font-bold">IG</a>
                    <a href="#" class="w-10 h-10 bg-slate-900 hover:bg-red-600 transition-colors rounded-lg flex items-center justify-center text-white text-xs font-bold">YT</a>
                    <a href="#" class="w-10 h-10 bg-slate-900 hover:bg-red-600 transition-colors rounded-lg flex items-center justify-center text-white text-xs font-bold">FB</a>
                </div>
            </div>
        </div>
    </div>
</section>
