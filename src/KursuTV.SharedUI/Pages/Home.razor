@page "/"
@using KursuTV.Business.DTOs
@using KursuTV.SharedUI.Components
@inject NewsApiService NewsApi
@inject CategoryApiService CategoryApi

<PageTitle>Kürsü TV - Bağımsız Haber, Son Dakika, Gündem ve Analiz</PageTitle>

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col justify-between">
    <div>
        <!-- 1. Header & Navigation -->
        <Header />

        <!-- 2. Son Dakika Ticker -->
        <BreakingNewsTicker BreakingNews="breakingNews" />

        <!-- 3. Ana İçerik Konteyneri -->
        <main class="max-w-7xl mx-auto px-4 py-6 space-y-8">
            <!-- MANŞET & KÖŞE YAZISI GRID'İ (Kürsü TV Ekran Görünümü) -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- SOL (2 Kolon): Dev 1-12 Manşet Slider'ı -->
                <div class="lg:col-span-2">
                    <HeadlineSlider Headlines="headlines" />
                </div>

                <!-- SAĞ (1 Kolon): 1-6 Köşe Yazısı Widget'ı -->
                <div class="lg:col-span-1">
                    <ColumnistWidget />
                </div>
            </div>

            <!-- REKLAM & SPONSOR BANDI (Responsive) -->
            <div class="bg-gradient-to-r from-slate-100 via-white to-slate-100 border border-slate-200 rounded-2xl p-4 text-center text-xs text-slate-400">
                <span class="font-bold text-slate-500">KÜRSÜ TV REKLAM ALANI</span> &bull; 728x90 Banner
            </div>

            <!-- BU HAFTA / ÖZEL VİDEO HABERLER -->
            <VideoNewsSection />

            <!-- GÜNDEMDEN SON GELİŞMELER (4 Kolonlu Grid) -->
            <div class="space-y-4">
                <div class="flex items-center justify-between border-b-2 border-red-600 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-600"></span>
                        <h2 class="text-lg font-black text-slate-900 tracking-tight uppercase">GÜNDEMDEN BAŞLIKLAR</h2>
                    </div>
                    <a href="/kategori/gundem" class="text-xs font-bold text-red-600 hover:text-red-700 hover:underline">
                        Daha Fazla &rarr;
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    @for (int i = 0; i < latestNews.Count; i++)
                    {
                        var item = latestNews[i];
                        <a href="/haber/@item.Slug" class="group bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md transition-all flex flex-col justify-between">
                            <div class="aspect-[16/9] bg-slate-100 overflow-hidden relative">
                                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.CoverImageAlt" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-slate-800 text-white text-xs font-bold">KTV</div>
                                }
                                @if (item.Categories.Count > 0)
                                {
                                    <span class="absolute top-2 left-2 px-2 py-0.5 bg-red-600 text-white text-[10px] font-bold rounded shadow-xs">
                                        @item.Categories[0].Name
                                    </span>
                                }
                            </div>

                            <div class="p-3.5 space-y-1.5 flex-1 flex flex-col justify-between">
                                <h3 class="text-xs font-bold text-slate-900 group-hover:text-red-600 transition-colors line-clamp-2 leading-snug">
                                    @item.Title
                                </h3>
                                <div class="flex items-center justify-between text-[10px] text-slate-400 pt-2 border-t border-slate-100">
                                    <span>@item.AuthorName</span>
                                    <span>@((item.PublishedAt ?? item.CreatedAt).ToString("dd.MM.yyyy"))</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </main>
    </div>

    <!-- 4. Footer -->
    <Footer />
</div>

@code {
    private List<HeadlineNewsDto> headlines = new();
    private List<BreakingNewsDto> breakingNews = new();
    private List<NewsListDto> latestNews = new();

    protected override async Task OnInitializedAsync()
    {
        headlines = await NewsApi.GetHeadlinesAsync(12);
        breakingNews = await NewsApi.GetBreakingNewsAsync(10);
        var paged = await NewsApi.GetPublishedNewsPagedAsync(1, 8);
        if (paged != null) latestNews = paged.Items;
    }
}
