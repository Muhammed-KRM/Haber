                errorMessage = result.ErrorMessage ?? "GiriÅŸ baÅŸarÄ±sÄ±z.";
                await JS.InvokeVoidAsync("kursutv.showSwal", "error", "GiriÅŸ BaÅŸarÄ±sÄ±z", errorMessage, 0);
                await JS.InvokeVoidAsync("console.log", $"[KursuTV Tracker] HATA: API giriÅŸi reddetti. Sebep: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Beklenmeyen sunucu hatasÄ±.";
            await JS.InvokeVoidAsync("console.error", $"[KursuTV Tracker] KRÄ°TÄ°K HATA: {ex.Message}");
