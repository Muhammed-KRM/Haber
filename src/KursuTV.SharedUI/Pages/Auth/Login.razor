                    await stateProvider.LogInAsync(user.Id, user.FullName, user.Email, user.Role ?? "User", result.Token);
                    await JS.InvokeVoidAsync("kursutv.showSwal", "success", "HoÅŸ Geldiniz! ğŸ‰", $"Merhaba {user.FullName}, ana sayfaya yÃ¶nlendiriliyorsunuz...", 2000);
                    await Task.Delay(2100);
