@page "/admin/settings"
@using KursuTV.Business.DTOs
@inject HttpClient Http
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Sistem AyarlarÄ± - Admin</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <PageHeader Title="Sistem AyarlarÄ±" 
                       Subtitle="Uygulama ayarlarÄ±nÄ± yÃ¶net" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="card">
            <div class="card-body">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">YÃ¼kleniyor...</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Jeton AyarlarÄ±</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var setting in settings)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold">@setting.Description</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" @bind="setting.Value" min="0" max="100" />
                                    <span class="input-group-text">Jeton</span>
                                    <button class="btn btn-outline-primary" @onclick="() => UpdateSetting(setting)" disabled="@isSaving">
                                        @if (isSaving)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save"></i>
                                        }
                                    </button>
                                </div>
                                <small class="text-muted">Anahtar: @setting.Key</small>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3">
                        @message
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Sistem Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <strong>Uygulama Versiyonu:</strong><br>
                            <span class="text-muted">v1.0.0</span>
                        </div>
                        <div class="mb-3">
                            <strong>VeritabanÄ±:</strong><br>
                            <span class="text-muted">PostgreSQL</span>
                        </div>
                        <div class="mb-3">
                            <strong>Cache:</strong><br>
                            <span class="text-muted">Redis</span>
                        </div>
                        <div class="mb-3">
                            <strong>Arama:</strong><br>
                            <span class="text-muted">Elasticsearch</span>
                        </div>
                        <div class="mb-3">
                            <strong>MesajlaÅŸma:</strong><br>
                            <span class="text-muted">RabbitMQ</span>
                        </div>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">HÄ±zlÄ± Ä°ÅŸlemler</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-info" @onclick="ClearCache">
                                <i class="fas fa-broom me-2"></i>Cache Temizle
                            </button>
                            <button class="btn btn-outline-warning" @onclick="ReindexSearch">
                                <i class="fas fa-sync me-2"></i>Arama Ä°ndeksini Yenile
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ExportLogs">
                                <i class="fas fa-download me-2"></i>LoglarÄ± Ä°ndir
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<GlobalSettingDto> settings = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string message = "";
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            isLoading = true;
            settings = await Http.GetFromJsonAsync<List<GlobalSettingDto>>("api/admin/settings") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ayarlar yÃ¼klenirken hata: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateSetting(GlobalSettingDto setting)
    {
        try
        {
            isSaving = true;
            message = "";

            var response = await Http.PutAsJsonAsync("api/admin/settings", setting);
            
            if (response.IsSuccessStatusCode)
            {
                message = "Ayar baÅŸarÄ±yla gÃ¼ncellendi.";
                isSuccess = true;
            }
            else
            {
                message = "Ayar gÃ¼ncellenirken hata oluÅŸtu.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            message = $"Hata: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }

        // MesajÄ± 3 saniye sonra temizle
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ClearCache()
    {
        try
        {
            // Cache temizleme endpoint'i henÃ¼z yok, simÃ¼le edelim
            await Task.Delay(1000);
            message = "Cache baÅŸarÄ±yla temizlendi.";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Cache temizlenirken hata: {ex.Message}";
            isSuccess = false;
        }

        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ReindexSearch()
    {
        try
        {
            // Elasticsearch reindex endpoint'i henÃ¼z yok, simÃ¼le edelim
            await Task.Delay(2000);
            message = "Arama indeksi baÅŸarÄ±yla yenilendi.";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Ä°ndeks yenilenirken hata: {ex.Message}";
            isSuccess = false;
        }

        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            message = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ExportLogs()
    {
        try
        {
            // Log export endpoint'i henÃ¼z yok, simÃ¼le edelim
            await Task.Delay(1500);
            message = "Loglar baÅŸarÄ±yla indirildi.";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Loglar indirilirken hata: {ex.Message}";
            isSuccess = false;
        }

        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            message = "";
            InvokeAsync(StateHasChanged);
        });
    }
}