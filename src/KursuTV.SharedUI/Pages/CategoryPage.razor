@page "/kategori/{Slug}"
@using KursuTV.Business.DTOs
@using KursuTV.SharedUI.Components
@inject CategoryApiService CategoryApi
@inject NewsApiService NewsApi

<PageTitle>@(category?.Name ?? "Kategori") Haberleri - Kürsü TV</PageTitle>

<div class="min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col justify-between">
    <div>
        <Header />

        <main class="max-w-7xl mx-auto px-4 py-6 space-y-6">
            @if (category != null)
            {
                <!-- Kategori Başlığı -->
                <div class="border-b-2 border-red-600 pb-3 flex items-center justify-between">
                    <div>
                        <h1 class="text-2xl font-black text-slate-900 uppercase tracking-tight">@category.Name</h1>
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            <p class="text-xs text-slate-500 mt-1">@category.Description</p>
                        }
                    </div>
                    <span class="text-xs font-semibold text-slate-500">Toplam @(pagedNews?.TotalCount ?? 0) haber</span>
                </div>

                <!-- Haber Listesi Gridi -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
                    @for (int i = 0; i < (pagedNews?.Items.Count ?? 0); i++)
                    {
                        var item = pagedNews!.Items[i];
                        <a href="/haber/@item.Slug" class="group bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-md transition-all flex flex-col justify-between">
                            <div class="aspect-[16/9] bg-slate-100 overflow-hidden relative">
                                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.CoverImageAlt" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-slate-800 text-white text-xs font-bold">KTV</div>
                                }
                            </div>

                            <div class="p-4 space-y-2 flex-1 flex flex-col justify-between">
                                <h3 class="text-sm font-bold text-slate-900 group-hover:text-red-600 transition-colors line-clamp-2 leading-snug">
                                    @item.Title
                                </h3>
                                @if (!string.IsNullOrEmpty(item.Spot))
                                {
                                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">@item.Spot</p>
                                }
                                <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-100">
                                    <span>@item.AuthorName</span>
                                    <span>@((item.PublishedAt ?? item.CreatedAt).ToString("dd.MM.yyyy"))</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>

                @if (pagedNews == null || pagedNews.Items.Count == 0)
                {
                    <div class="py-16 text-center text-slate-400 text-xs">
                        Bu kategoride henüz yayınlanmış haber bulunmuyor.
                    </div>
                }
            }
            else if (isLoading)
            {
                <div class="py-24 text-center text-slate-400 text-sm animate-pulse">Kategori yükleniyor...</div>
            }
        </main>
    </div>

    <Footer />
</div>

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private CategoryDto? category;
    private PagedResultDto<NewsListDto>? pagedNews;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        if (!string.IsNullOrEmpty(Slug))
        {
            category = await CategoryApi.GetBySlugAsync(Slug);
            if (category != null)
            {
                pagedNews = await NewsApi.GetPublishedNewsPagedAsync(1, 24, category.Id);
            }
        }
        isLoading = false;
    }
}
