@code {
    [Parameter]
    public string City { get; set; } = string.Empty;

    [Parameter]
    public string Branch { get; set; } = string.Empty;

    public string FormattedCity => char.ToUpper(City[0]) + City.Substring(1).Replace("-", " ");
    public string FormattedBranch => char.ToUpper(Branch[0]) + Branch.Substring(1).Replace("-", " ");

    private List<KursuTV.Business.DTOs.ListingDto> listings = new();

    protected override async Task OnInitializedAsync()
    {
        var searchResult = await ListingService.SearchAsync(new KursuTV.Business.DTOs.SearchFilterDto { City = City, Branch = Branch });
        listings = searchResult.Items.ToList();
    }
}
