@using KursuTV.Business.DTOs
@inject CategoryApiService CategoryApi

<footer class="bg-slate-950 text-slate-400 font-sans border-t-4 border-red-600 mt-16 select-none">
    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- 1. Marka & Hakkında -->
            <div class="space-y-4 md:col-span-1">
                <a href="/" class="inline-block">
                    <span class="font-black text-3xl tracking-tighter text-white uppercase">
                        KÜRSÜ<span class="text-red-500">TV</span>
                    </span>
                </a>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Kürsü TV; bağımsız, ilkeli ve hızlı habercilik anlayışıyla Türkiye ve dünyadaki son gelişmeleri okuyucularına anında aktarır.
                </p>
                <div class="flex items-center gap-2 pt-1 pb-1 text-slate-400">
                    <a href="https://www.youtube.com/c/kursutv" target="_blank" rel="noopener noreferrer" class="p-1.5 hover:text-red-500 hover:bg-white/5 rounded-lg transition-colors" title="YouTube"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
                    <a href="https://x.com/kursu_tv" target="_blank" rel="noopener noreferrer" class="p-1.5 hover:text-white hover:bg-white/5 rounded-lg transition-colors" title="X"><svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
                    <a href="https://www.instagram.com/kursu.tv" target="_blank" rel="noopener noreferrer" class="p-1.5 hover:text-pink-500 hover:bg-white/5 rounded-lg transition-colors" title="Instagram"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>
                    <a href="https://www.facebook.com/kursutv" target="_blank" rel="noopener noreferrer" class="p-1.5 hover:text-blue-500 hover:bg-white/5 rounded-lg transition-colors" title="Facebook"><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
                </div>
                <div class="text-[11px] text-slate-500">
                    &copy; @DateTime.Now.Year Kürsü TV. Tüm hakları saklıdır.
                </div>
            </div>

            <!-- 2. Kategoriler (Dinamik Veritabanı) -->
            <div class="space-y-3">
                <h4 class="text-xs font-bold text-white uppercase tracking-wider">Kategoriler</h4>
                <ul class="space-y-1.5 text-xs">
                    @if (categories.Count > 0)
                    {
                        @foreach (var cat in categories)
                        {
                            <li><a href="/kategori/@cat.Slug" class="hover:text-white transition-colors">@cat.Name</a></li>
                        }
                    }
                    else
                    {
                        <li><a href="/kategori/gundem" class="hover:text-white transition-colors">Gündem</a></li>
                        <li><a href="/kategori/politika" class="hover:text-white transition-colors">Politika</a></li>
                        <li><a href="/kategori/ekonomi" class="hover:text-white transition-colors">Ekonomi</a></li>
                        <li><a href="/kategori/dunya" class="hover:text-white transition-colors">Dünya</a></li>
                        <li><a href="/kategori/spor" class="hover:text-white transition-colors">Spor</a></li>
                    }
                    <li><a href="/yazarlar" class="hover:text-white transition-colors">Yazarlar</a></li>
                </ul>
            </div>

            <!-- 3. Kurumsal & Hukuk -->
            <div class="space-y-3">
                <h4 class="text-xs font-bold text-white uppercase tracking-wider">Kurumsal</h4>
                <ul class="space-y-1.5 text-xs">
                    <li><a href="/kunye" class="hover:text-white transition-colors">Künye</a></li>
                    <li><a href="/iletisim" class="hover:text-white transition-colors">İletişim</a></li>
                    <li><a href="/gizlilik" class="hover:text-white transition-colors">Gizlilik İlkeleri</a></li>
                    <li><a href="/kullanim-kosullari" class="hover:text-white transition-colors">Kullanım Şartları</a></li>
                    <li><a href="/cerez-politikasi" class="hover:text-white transition-colors">Çerez Politikası</a></li>
                    <li><a href="/kvkk" class="hover:text-white transition-colors">KVKK Aydınlatma</a></li>
                    <li><a href="/iptal-iade-kosullari" class="hover:text-white transition-colors">İptal ve İade</a></li>
                    <li><a href="/mesafeli-satis-sozlesmesi" class="hover:text-white transition-colors">Mesafeli Satış</a></li>
                </ul>
            </div>

            <!-- 4. Yayın & XML Haritaları -->
            <div class="space-y-3">
                <h4 class="text-xs font-bold text-white uppercase tracking-wider">Yayın & Veri Akışı</h4>
                <ul class="space-y-1.5 text-xs">
                    <li>
                        <a href="http://localhost:5000/sitemap.xml" target="_blank" class="hover:text-red-400 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            XML Sitemap
                        </a>
                    </li>
                    <li>
                        <a href="http://localhost:5000/news-sitemap.xml" target="_blank" class="hover:text-red-400 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                            Google News Sitemap
                        </a>
                    </li>
                    <li>
                        <a href="http://localhost:4201" target="_blank" class="hover:text-red-400 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                            Editör & Yönetim Girişi
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>

@code {
    private List<CategoryDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await CategoryApi.GetFlatAsync();
            categories = all
                .Where(c => c.ParentId == null && c.Slug != "kose-yazilari")
                .OrderBy(c => c.SortOrder)
                .Take(7)
                .ToList();
        }
        catch
        {
            // Sessiz hata yakalama
        }
    }
}
