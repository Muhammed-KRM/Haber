@using KursuTV.Business.DTOs
@inject NewsApiService NewsApi

@if (articles.Count > 0)
{
    <div class="bg-gradient-to-br from-red-800 via-rose-700 to-red-900 rounded-2xl p-5 text-white shadow-xl flex flex-col justify-between relative overflow-hidden select-none">
        <!-- Arka plan hafif amblem -->
        <div class="absolute -right-8 -bottom-8 w-40 h-40 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>

        <div class="space-y-4">
            <!-- Başlık Rozeti -->
            <div class="flex items-center justify-between">
                <span class="text-[10px] font-black uppercase tracking-widest text-red-200 bg-red-950/40 px-2 py-0.5 rounded border border-white/10">
                    KÖŞE YAZISI
                </span>
                <span class="text-xs text-white/80 font-medium">@CurrentAuthor.Date</span>
            </div>

            <!-- Yazı Başlığı -->
            <a href="/haber/@CurrentAuthor.ArticleSlug" class="block group">
                <h3 class="text-lg sm:text-xl font-extrabold text-white group-hover:text-red-100 transition-colors leading-tight line-clamp-3">
                    @CurrentAuthor.ArticleTitle
                </h3>
            </a>
        </div>

        <!-- Yazar Profil & Fotoğraf Alanı -->
        <div class="mt-6 pt-4 border-t border-white/15 flex items-center justify-between">
            <div>
                <h4 class="text-sm font-bold text-white leading-none">@CurrentAuthor.AuthorName</h4>
                <span class="text-[11px] text-red-200 font-medium mt-0.5 block">Kürsü TV Köşe Yazarı</span>
            </div>

            <div class="w-14 h-14 rounded-full border-2 border-white/60 shadow-lg overflow-hidden bg-slate-900 shrink-0 flex items-center justify-center">
                @if (!string.IsNullOrEmpty(CurrentAuthor.ProfileImageUrl) && !CurrentAuthor.ProfileImageUrl.Contains("default-avatar"))
                {
                    <img 
                        src="@CurrentAuthor.ProfileImageUrl" 
                        alt="@CurrentAuthor.AuthorName" 
                        class="w-full h-full object-cover"
                    />
                }
                else
                {
                    <span class="text-lg font-black text-white">@CurrentAuthor.AuthorName.FirstOrDefault()</span>
                }
            </div>
        </div>

        <!-- 1-N Sayfalama Butonları -->
        @if (articles.Count > 1)
        {
            <div class="mt-4 pt-3 flex items-center justify-center gap-1.5 border-t border-white/10">
                @for (int i = 0; i < articles.Count; i++)
                {
                    var idx = i;
                    <button 
                        @onclick="() => activeIndex = idx"
                        class="w-6 h-6 rounded-md font-bold text-xs transition-all flex items-center justify-center"
                        style="@(activeIndex == idx ? "background-color: #ffffff; color: #dc2626;" : "background-color: rgba(255,255,255,0.15); color: #ffffff;")"
                    >
                        @(idx + 1)
                    </button>
                }
            </div>
        }
    </div>
}
else if (!isLoading)
{
    <div class="bg-gradient-to-br from-red-800 via-rose-700 to-red-900 rounded-2xl p-5 text-white shadow-xl flex flex-col justify-center items-center min-h-[200px] text-center">
        <span class="text-xs text-red-200">Henüz yayınlanmış köşe yazısı bulunmuyor.</span>
    </div>
}

@code {
    private int activeIndex = 0;
    private bool isLoading = true;

    public record ColumnistItem(
        string AuthorName,
        string ArticleTitle,
        string ArticleSlug,
        string ProfileImageUrl,
        string Date
    );

    private List<ColumnistItem> articles = new();

    private ColumnistItem CurrentAuthor => 
        articles.Count > 0 ? articles[activeIndex % articles.Count] : new ColumnistItem("", "", "", "", "");

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var columnNews = await NewsApi.GetColumnNewsAsync(6);
            articles = columnNews.Select(n => new ColumnistItem(
                AuthorName: n.AuthorName,
                ArticleTitle: n.Title,
                ArticleSlug: n.Slug,
                ProfileImageUrl: n.CoverImageUrl ?? "",
                Date: (n.PublishedAt ?? n.CreatedAt).ToString("dd MMMM")
            )).ToList();
        }
        catch
        {
            articles = new();
        }
        finally
        {
            isLoading = false;
        }
    }
}
